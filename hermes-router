#!/usr/bin/env bash
#
# hermes-router (also: hr) — command-line wrapper
#
# Usage:
#   hr setup                          Interactive first-run wizard (start here)
#   hr auth add <provider>            Add API key(s) for a provider
#   hr auth import-codex              Import a ChatGPT-subscription login from the Codex CLI
#   hr auth list                      Show all providers and how many keys are configured
#   hr model list                     Show all providers and their active model
#   hr model set <provider> <model>   Override a provider's model
#   hr model reset <provider>         Revert a provider to its default model
#   hr mode                           Show how keys are rotated within a provider
#   hr mode <round-robin|sequential>  Set the key rotation mode
#   hr limit list                     Show per-proxy-key rate/budget limits
#   hr limit set <key> [opts]         Set a key's rpm / req-per-day / tokens-per-day
#   hr limit clear <key>              Remove a key's limits
#   hr features list                  Show core features + optional add-ons (on/off)
#   hr features enable|disable <name> Turn an add-on on/off (writes .env)
#   hr service install                Run as a service that survives reboots (systemd)
#   hr service status|uninstall       Show / remove the boot service
#   hr start                          Run the router (same as: python router.py)
#   hr status                         Live health dashboard for the running router
#   hr enroll <provider> <model>      Fingerprint a model and save its adapter profile
#   hr enroll list                    Show enrolled vs configured models
#   hr enroll check                   Run enrollment self-check (no network)
#   hr restart                        Restart the router so key/config changes take effect
#   hr doctor                         Diagnose installation issues
#   hr update [--check]               Update to the latest version (safe; auto-rollback)
#   hr version                        Show the installed version
#   hr help                           Show all commands
#
# Enrollment tip: prefer offline `hr enroll` / staging PORT=8320 before flipping
# ENROLLMENT_ADAPTERS=1 on production (:8319). Optional: HERMES_ROUTER_URL for API enroll.
#
# Install with ./install.sh — creates venv, installs deps, and puts `hr` on PATH.
#
set -uo pipefail

# Resolve this script's real location (following symlinks) so we can find the
# repo even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
REPO="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Prefer the venv Python created by install.sh; fall back to system python3.
if [ -f "$REPO/venv/bin/python" ]; then
  PYTHON="${PYTHON:-$REPO/venv/bin/python}"
else
  PYTHON="${PYTHON:-python3}"
fi

usage() { awk 'NR>1 && /^#/ {sub(/^#[[:space:]]?/,""); print; next} NR>1 {exit}' "$SOURCE"; }

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  setup)
    exec "$REPO/scripts/setup.sh" "$@"
    ;;
  auth)
    exec "$REPO/scripts/auth.sh" "$@"
    ;;
  model)
    exec "$REPO/scripts/model.sh" "$@"
    ;;
  mode)
    exec "$REPO/scripts/mode.sh" "$@"
    ;;
  limit)
    exec "$REPO/scripts/limit.sh" "$@"
    ;;
  features)
    exec "$REPO/scripts/features.sh" "$@"
    ;;
  service)
    exec "$REPO/scripts/service.sh" "$@"
    ;;
  status)
    exec "$REPO/scripts/status.sh" "$@"
    ;;
  enroll)
    sub="${1:-}"
    case "$sub" in
      list)
        shift 2>/dev/null || true
        exec "$PYTHON" -m enrollment list "$@"
        ;;
      check|self-check)
        shift 2>/dev/null || true
        exec "$PYTHON" -m enrollment check "$@"
        ;;
      "")
        echo "usage: hr enroll <provider> <model> | hr enroll list | hr enroll check" >&2
        exit 2
        ;;
      *)
        # Offline battery (no running router required). Prefer this for staging.
        # To hit a live router API instead: HERMES_ROUTER_URL=http://127.0.0.1:8320 hr enroll …
        if [ -n "${HERMES_ROUTER_URL:-}" ]; then
          provider="$1"; model="$2"
          if [ -z "${provider:-}" ] || [ -z "${model:-}" ]; then
            echo "usage: HERMES_ROUTER_URL=… hr enroll <provider> <model>" >&2
            exit 2
          fi
          key="${PROXY_API_KEY:-${HERMES_ROUTER_KEY:-}}"
          if [ -z "$key" ]; then
            # fall back to first PROXY_API_KEYS entry from .env if present
            key="$("$PYTHON" -c "
import os
from pathlib import Path
p=Path('$REPO')/'.env'
if p.exists():
  for line in p.read_text().splitlines():
    if line.startswith('PROXY_API_KEYS='):
      print(line.split('=',1)[1].split(',')[0].strip()); break
")"
          fi
          exec curl -sS -X POST "${HERMES_ROUTER_URL%/}/v1/enroll" \
            -H "Authorization: Bearer ${key}" \
            -H "Content-Type: application/json" \
            -d "{\"provider\":\"$provider\",\"model\":\"$model\"}"
        fi
        exec "$PYTHON" -m enrollment enroll "$@"
        ;;
    esac
    ;;
  restart)
    exec "$REPO/scripts/restart.sh" "$@"
    ;;
  doctor)
    exec "$REPO/scripts/doctor.sh" "$@"
    ;;
  update)
    HR_INVOKE="hermes-router update" exec "$REPO/scripts/update.sh" "$@"
    ;;
  start|run|serve)
    exec "$PYTHON" "$REPO/router.py" "$@"
    ;;
  version|--version|-v)
    v="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "hermes-router ${v}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "unknown command: ${cmd}" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
