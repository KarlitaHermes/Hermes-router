#!/usr/bin/env bash
#
# hermes-router (also: hr) — command-line wrapper
#
# Usage:
#   hr setup                          Interactive first-run wizard (start here)
#   hr auth add <provider>            Add API key(s) for a provider
#   hr auth list                      Show all providers and how many keys are configured
#   hr model list                     Show all providers and their active model
#   hr model set <provider> <model>   Override a provider's model
#   hr model reset <provider>         Revert a provider to its default model
#   hr mode                           Show how keys are rotated within a provider
#   hr mode <round-robin|sequential>  Set the key rotation mode
#   hr start                          Run the router (same as: python router.py)
#   hr status                         Live health dashboard for the running router
#   hr restart                        Restart the router so key/config changes take effect
#   hr doctor                         Diagnose installation issues
#   hr update [--check]               Update to the latest version (safe; auto-rollback)
#   hr version                        Show the installed version
#   hr help                           Show all commands
#
# Install with ./install.sh — creates venv, installs deps, and puts `hr` on PATH.
#
set -uo pipefail

# Resolve this script's real location (following symlinks) so we can find the
# repo even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
REPO="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Prefer the venv Python created by install.sh; fall back to system python3.
if [ -f "$REPO/venv/bin/python" ]; then
  PYTHON="${PYTHON:-$REPO/venv/bin/python}"
else
  PYTHON="${PYTHON:-python3}"
fi

usage() { awk 'NR>1 && /^#/ {sub(/^#[[:space:]]?/,""); print; next} NR>1 {exit}' "$SOURCE"; }

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  setup)
    exec "$REPO/scripts/setup.sh" "$@"
    ;;
  auth)
    exec "$REPO/scripts/auth.sh" "$@"
    ;;
  model)
    exec "$REPO/scripts/model.sh" "$@"
    ;;
  mode)
    exec "$REPO/scripts/mode.sh" "$@"
    ;;
  status)
    exec "$REPO/scripts/status.sh" "$@"
    ;;
  restart)
    exec "$REPO/scripts/restart.sh" "$@"
    ;;
  doctor)
    exec "$REPO/scripts/doctor.sh" "$@"
    ;;
  update)
    HR_INVOKE="hermes-router update" exec "$REPO/scripts/update.sh" "$@"
    ;;
  start|run|serve)
    exec "$PYTHON" "$REPO/router.py" "$@"
    ;;
  version|--version|-v)
    v="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "hermes-router ${v}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "unknown command: ${cmd}" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
